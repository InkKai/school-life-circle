@model StoreListItem
@{
    var s = Model.Store;
    var cat = s.Category;
}
<article class="store-row">
    <div class="thumb" style="background:@Ui.Tint(cat)">@if (!string.IsNullOrEmpty(s.PhotoUrl)) {<img src="@Url.Content(s.PhotoUrl)" alt="" loading="lazy" />} else {@Ui.Art(s)}</div>
    <div class="body">
        <h3><a class="stretched-link" href="@Url.Action("Details", "Stores", new { id = s.Id })">@s.Name</a></h3>
        <p class="meta">
            @if (Model.DistanceMeters.HasValue)
            {
                <span>@Ui.Ic("walk") @Geo.WalkMinutes(Model.DistanceMeters.Value) 分・@Geo.Format(Model.DistanceMeters.Value)</span>
            }
            <span>@(cat != null ? cat.Name : "")</span>
        </p>
        <div class="d-flex flex-wrap gap-1">
            @if (Model.ActiveCoupons > 0)
            {
                <span class="chip chip-brand">@Model.ActiveCoupons 張優惠</span>
            }
            @if (s.StampGoal > 0)
            {
                <span class="chip chip-soft">集點</span>
            }
            @if (Model.AverageRating.HasValue)
            {
                <span class="chip chip-gray">★ @Model.AverageRating.Value.ToString("0.0")</span>
            }
            @if (s.AccessibilityKnown && (s.StepFreeEntrance || s.HasRamp))
            {
                <span class="chip chip-green">輪椅可進入</span>
            }
        </div>
    </div>
</article>
