@model Store
@{ ViewBag.Title = "店家照片"; }

<h1 class="mb-3">@Model.Name</h1>
@Html.Partial("_MerchantNav", Model)

<div class="row g-3">
    <div class="col-lg-6">
        <div class="panel">
            <h2 class="h5 fw-bold">上傳店家照片</h2>
            <p class="small text-ink-2">店面、招牌菜或老闆本人都可以，有照片的店更容易被點開。</p>
            @using (Html.BeginForm("Photo", "Merchant", new { storeId = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <label for="photo" class="form-label fw-semibold">選擇照片（JPG／PNG，3 MB 以內）</label>
                <input type="file" id="photo" name="photo" class="form-control mb-3" accept=".jpg,.jpeg,.png,image/jpeg,image/png" capture="environment" required />
                <button type="submit" class="btn btn-brand w-100">@Ui.Ic("camera") 上傳</button>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel">
            <h2 class="h5 fw-bold">目前的照片</h2>
            @if (string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <div class="empty-state"><img class="mascot" src="@Url.Content("~/Content/img/mascot-point.svg")" alt="" /><p>還沒有照片，先用插圖代替</p></div>
            }
            else
            {
                <img src="@Url.Content(Model.PhotoUrl)" alt="@Model.Name 的店家照片" class="img-fluid rounded-4" />
            }
        </div>
    </div>
</div>
