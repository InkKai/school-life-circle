@model List<Product>
@{
    ViewBag.Title = "商品與服務";
    var store = (Store)ViewBag.Store;
}

<h1 class="mb-3">@store.Name</h1>
@Html.Partial("_MerchantNav", store)
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">商品與服務（@Model.Count）</h2>
    @Html.ActionLink("＋ 新增", "CreateProduct", new { storeId = store.Id }, new { @class = "btn btn-smile" })
</div>

@if (!Model.Any())
{
    <p>還沒有商品，按「新增」開始建立。</p>
}
else
{
    <table class="table bg-white align-middle">
        <thead><tr><th scope="col">名稱</th><th scope="col" class="text-end">價格</th><th scope="col">狀態</th><th scope="col"><span class="visually-hidden">操作</span></th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td class="text-end">@p.Price 元</td>
                    <td>@(p.IsAvailable ? "供應中" : "暫停供應")</td>
                    <td class="text-end text-nowrap">
                        @Html.ActionLink("修改", "EditProduct", new { id = p.Id }, new { @class = "btn btn-sm btn-outline-smile" })
                        @using (Html.BeginForm("DeleteProduct", "Merchant", new { id = p.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('確定刪除這個商品？');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
